# jsona share-server configuration
PORT=8787
# Public base URL where this server is reachable (used in short-link responses)
PUBLIC_URL=http://localhost:8787
# Share link TTL in seconds (default 7 days). Set 0 to disable expiry.
SHARE_TTL=604800
# Workspace document TTL in seconds (default 30 days). Set 0 to disable expiry.
WORKSPACE_TTL=2592000
# GitHub OAuth (optional). Leave blank to disable account sync.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated list of allowed GitHub usernames that may use account sync.
GITHUB_ALLOWED_USERS=
# A random secret used to sign session cookies (any long string).
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please-change-me-to-a-long-random-string
# AES-256-GCM master key for encrypting user BYOK keys at rest (64 hex chars).
# Same generator as above. Not set = in-memory key (keys lost on restart).
BYOK_MASTER_KEY=please-change-me-to-a-64-hex-random-string
# Path to the SQLite database file (WASM engine, no native deps).
# A legacy ./data/share.json is imported automatically on first start.
DB_PATH=./data/share.db
# Comma-separated list of allowed web-client origins for CORS.
# Use * to allow any, or list e.g. https://jsona.example.com
PUBLIC_ORIGINS=*

# --- Abuse protection ---
# Set to 1 only when running behind a trusted reverse proxy, so that
# X-Forwarded-For is used for per-IP limits (otherwise it can be forged).
TRUST_PROXY=0
# Rate-limit window in milliseconds.
RATE_WINDOW_MS=60000
# Max write requests (share create / workspace save-delete) per window per IP.
RATE_WRITE_MAX=20
# Max read requests per window per IP.
RATE_READ_MAX=120
# Max accepted document size in bytes for shares and workspaces.
MAX_SHARE_BYTES=4000000
# Max stored workspaces per account.
MAX_WORKSPACES_PER_USER=50

# --- Plan tiers (optional allow-lists) ---
# Comma-separated GitHub logins granted Pro / Team quota in plans.ts.
# Empty = everyone gets Free tier. Real payments not yet wired (see DEPLOY.md).
PRO_LOGINS=
TEAM_LOGINS=
